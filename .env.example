# Bắt buộc: Lấy tại https://www.kaggle.com/settings -> API
KAGGLE_USERNAME=your_kaggle_username
# Hỗ trợ cả token mới (KGAT_...) lẫn key hex cũ
KAGGLE_KEY=KGAT_your_token_here

# Tuỳ chọn nâng cao (bỏ trống sẽ tự dùng Cloudflare Quick Tunnel không cần cài đặt gì thêm):
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=kaggle-mcp-worker
